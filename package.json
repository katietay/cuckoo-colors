{
  "name": "cuckoo-colors",
  "version": "1.0.0",
  "description": "Cuckoo Colors: an accessible color coordinate activity generator built with Angular, Express and SQLite.",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "ng": "ng",
    "dev:web": "ng serve",
    "dev:api": "node --watch api/index.js",
    "build": "ng build",
    "start": "node api/index.js",
    "test": "npm run test:api && npm run test:contract && npm run test:web",
    "test:api": "node --test \"api/test/*.test.js\"",
    "test:web": "ng test --watch=false --browsers=ChromeHeadlessCI --reporters=dots",
    "test:watch": "ng test",
    "audit:prod": "npm audit --omit=dev",
    "token": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "package:ionos": "node scripts/package-ionos.mjs",
    "test:contract": "node contract/run.js node && node contract/run.js php"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fontsource/poppins": "^5.2.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@types/jasmine": "~7.0.0",
    "@types/node": "^22.0.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "webpack-dev-middleware": "^7.4.5",
    "uuid": "^11.1.1"
  }
}
