# Copy to .env (which is git-ignored) and fill in. Never commit .env.

# Key required to add, edit or delete colors. Leave empty for a read-only site.
# Generate one with: npm run token   (minimum 16 characters)
ADMIN_TOKEN=

# Where the SQLite file lives. On a host, point this at a persistent disk.
DATABASE_PATH=data/colors.db

PORT=3000
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production.

# Set to the number of reverse proxies in front of the app (usually 1 on a host)
# so rate limiting sees real visitor IPs.
TRUST_PROXY=false

# NODE_ENV=production
